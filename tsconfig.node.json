{
  // tools/ and test/, which run in Node, checked as strictly as tsconfig.json checks public/js/,
  // with Node's types (@types/node, of Node 22, the oldest engines allows) as well as
  // tsconfig.json's DOM (the tests run public/js/'s modules, the text view's on a fake DOM).
  // types/node/ has what tools/ uses of common's tools. test/types.test.js runs it too.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["test/**/*.js", "tools/*.mjs", "types/*.d.ts", "types/node/*.d.ts"]
}
