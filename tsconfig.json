{
  // The page's modules checked as they are served, from their JSDoc, with `strict` on: nothing is
  // built or emitted, and the import map stays. test/types.test.js runs it (npm test, so the Pages
  // workflow too); npm run types runs it alone, then tsconfig.node.json (tools/ and test/, which
  // run in Node).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["public/js/*.js", "types/*.d.ts"]
}
