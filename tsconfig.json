{
  // The page's modules checked as they are served, from their JSDoc: nothing is built or emitted,
  // and the import map stays. test/types.test.js runs it (npm test, so the Pages workflow too);
  // npm run types runs it alone. Not strict yet: that comes a file at a time.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["public/js/*.js", "types/*.d.ts"]
}
