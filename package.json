{
  "name": "outside",
  "version": "0.1.0",
  "description": "A small WebXR garden outside one of the hallway's doors: a lawn, a stream and a pond, a foot bridge, and a bench to sit and read on. In VR, on a desktop or on a phone.",
  "keywords": ["webxr", "virtual-reality", "threejs", "meta-quest", "garden"],
  "homepage": "https://ariamokr.github.io/outside/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/outside.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/outside/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node node_modules/common/tools/vendor.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.strict.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "common": "github:AriaMoKr/common#v0.7.1",
    "layersharedsession": "github:AriaMoKr/layersharedsession#v0.3.0",
    "three": "0.186.1",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "iwer": "^2.5.0",
    "typescript": "5.9.3"
  }
}
